# Скопируйте в .env и заполните: cp .env.example .env
# .env в git не попадает (см. .gitignore). Здесь — только имена и безопасные примеры.

# Обязательно. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# 1 — режим разработки (трейсбеки, статика через runserver). В проде — 0 или не задавать.
DEBUG=1

# Хосты, с которых принимаются запросы, через запятую. "*" не использовать.
ALLOWED_HOSTS=localhost,127.0.0.1

# Пусто — SQLite (db.sqlite3). Для PostgreSQL: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# 1 — расчёт через очередь Redis/RQ (нужен воркер: python manage.py rqworker), 0 — фоновый поток.
USE_QUEUE=0
REDIS_URL=redis://localhost:6379/0
